---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Context Log Bot — AI Work Memory for People Who Context-Switch"
  description="Never lose context when you switch tasks. AI Telegram bot that logs your work by voice and gives you a ready status update in one click. Join the waitlist."
  image="/og-context-log-bot.png"
>
  <div class="clb-page">

    <!-- ── HERO ── -->
    <section class="clb-hero animate-fade-in">
      <div class="clb-hero-badge badge badge-gradient">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Coming soon · Join the waitlist
      </div>

      <h1 class="clb-hero-title">
        <span class="clb-brand-name">Context Log Bot</span>
        <br />
        Stop losing context<br />
        when you <span class="gradient-text">switch tasks</span>
      </h1>

      <p class="clb-hero-sub">
        <strong>Context Log Bot</strong> is a Telegram bot that asks <em>"What did you do in the last 30 minutes?"</em>,
        saves your voice replies by context, and gives you a ready-to-send status update in one click —
        no memory reconstruction needed.
      </p>

      <div class="clb-hero-cta">
        <a href="#waitlist" class="button clb-btn-primary">
          Get early access
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <p class="clb-hero-note">Free for early adopters · No spam · Unsubscribe any time</p>

      <div class="clb-hero-glow"></div>
    </section>

    <!-- ── PROBLEM ── -->
    <section class="clb-section animate-slide-up">
      <div class="clb-section-label">The Problem</div>
      <h2 class="clb-section-title">Context disappears the moment you switch</h2>

      <div class="clb-problem-grid">
        <div class="clb-problem-card glass-card">
          <div class="clb-problem-icon">😤</div>
          <h3>Your boss asks "how's it going?"</h3>
          <p>You just switched from a deep debugging session to a startup call. You need 5 minutes to remember what you even did this morning.</p>
        </div>
        <div class="clb-problem-card glass-card">
          <div class="clb-problem-icon">🔁</div>
          <h3>You juggle 5+ parallel tracks</h3>
          <p>Work, startup, product ideas, personal tasks — each with its own context. Every switch costs you minutes of mental reconstruction.</p>
        </div>
        <div class="clb-problem-card glass-card">
          <div class="clb-problem-icon">📉</div>
          <h3>End-of-day reports are painful</h3>
          <p>Writing a status update means scrolling through Slack, Git commits, and calendar — just to recall what actually happened.</p>
        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ── -->
    <section class="clb-section clb-how">
      <div class="clb-section-label">How it works</div>
      <h2 class="clb-section-title">Capture → Sort → Retrieve</h2>

      <ol class="clb-steps">
        <li class="clb-step glass-card">
          <div class="clb-step-num">1</div>
          <div class="clb-step-body">
            <h3>Bot checks in every 30 min</h3>
            <p>"What did you do in the last 30 minutes?" — a short Telegram message. Answer by voice or text in under 20 seconds.</p>
          </div>
        </li>
        <li class="clb-step glass-card">
          <div class="clb-step-num">2</div>
          <div class="clb-step-body">
            <h3>AI structures and files the entry</h3>
            <p>Speech-to-text transcribes your voice. LLM extracts context, summary, result, and next step — saved to your Google Sheet.</p>
          </div>
        </li>
        <li class="clb-step glass-card">
          <div class="clb-step-num">3</div>
          <div class="clb-step-body">
            <h3>One click → ready status update</h3>
            <p>Press <strong>Status: work</strong> and get a clean, copy-paste-ready update for your boss, client, or standup. No context reconstruction.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ── CONCEPT DEMO ── -->
    <section class="clb-section animate-slide-up">
      <div class="clb-demo glass-card">
        <div class="clb-demo-header">
          <div class="clb-demo-dot clb-dot-yellow"></div>
          <span class="clb-demo-title">Concept · How it will work</span>
        </div>
        <div class="clb-demo-chat">
          <div class="clb-msg clb-msg-bot">
            <span class="clb-msg-sender">Bot</span>
            <span class="clb-msg-text">What did you do in the last 30 minutes?</span>
          </div>
          <div class="clb-msg clb-msg-user">
            <span class="clb-msg-sender">You 🎤 voice reply</span>
            <span class="clb-msg-text">Debugging webhook retries, checked logs, found events lost after timeout. Next: test fix on staging.</span>
          </div>
          <div class="clb-msg clb-msg-bot">
            <span class="clb-msg-sender">Bot</span>
            <span class="clb-msg-text">Saved to <strong>work</strong> · debugging webhook retries, found timeout issue. Next: staging fix.</span>
            <div class="clb-msg-buttons">
              <button type="button" class="clb-tg-btn">✓ Ok</button>
              <button type="button" class="clb-tg-btn">✏️ Edit</button>
              <button type="button" class="clb-tg-btn clb-tg-btn-accent">📋 Status: work</button>
            </div>
          </div>
          <div class="clb-msg clb-msg-bot clb-msg-status">
            <span class="clb-msg-sender">Bot · Status: work</span>
            <span class="clb-msg-text">
              This morning:<br />
              – debugged webhook retry logic<br />
              – checked timeout-related logs<br />
              – found likely root cause of event loss<br />
              – next: verify fix on staging
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FEATURES ── -->
    <section class="clb-section">
      <div class="clb-section-label">Features</div>
      <h2 class="clb-section-title">Everything you need to stay on top of your work</h2>

      <div class="clb-features-grid">
        {[
          { emoji: "🎙️", title: "Voice-first input", desc: "Speak naturally. The bot transcribes, structures, and files your entry automatically." },
          { emoji: "🗂️", title: "Auto-context detection", desc: "AI classifies each entry: work, startup, personal, sport. Edit in one tap if needed." },
          { emoji: "⚡", title: "1-click status update", desc: "Per-context status buttons generate a ready-to-copy update in seconds." },
          { emoji: "📊", title: "Google Sheets sync", desc: "All entries land in your own Google Sheet. Readable, filterable, always yours." },
          { emoji: "🕳️", title: "Gap detection", desc: "Bot tells you which contexts haven't been touched in days so nothing slips." },
          { emoji: "📅", title: "Daily & weekly summaries", desc: "End-of-day rollup across all contexts. Weekly export to Google Docs." },
        ].map((f) => (
          <div class="clb-feature glass-card">
            <div class="clb-feature-emoji">{f.emoji}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── WHO IT'S FOR ── -->
    <section class="clb-section clb-audience">
      <div class="clb-section-label">Who it's for</div>
      <h2 class="clb-section-title">Built for high-context switchers</h2>
      <div class="clb-audience-list">
        {[
          ["🧑‍💻", "CTOs & Tech Leads", "Quick answers on progress without memory reconstruction"],
          ["🚀", "Founders", "Juggling product, sales, hiring and ops across the same day"],
          ["💼", "Freelancers & Consultants", "Per-client context and billable log — always ready"],
          ["👥", "People Managers", "Many comms, meetings, and delivery tracks to stay on top of"],
          ["🏠", "Remote workers", "Visible progress without endless status calls"],
        ].map(([emoji, title, desc]) => (
          <div class="clb-audience-card glass-card">
            <span class="clb-audience-emoji">{emoji}</span>
            <div>
              <h3>{title}</h3>
              <p>{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── PLANNED PRICING ── -->
    <section class="clb-section">
      <div class="clb-section-label">Planned pricing</div>
      <h2 class="clb-section-title">Free to start, affordable to keep</h2>
      <p class="clb-pricing-note">These are tentative tiers — early adopters on the waitlist get extended free access when we launch.</p>

      <div class="clb-pricing-grid">
        <div class="clb-plan glass-card">
          <div class="clb-plan-badge-coming">Planned</div>
          <div class="clb-plan-name">Free</div>
          <div class="clb-plan-price">$0</div>
          <ul class="clb-plan-features">
            <li>Up to 50 entries / month</li>
            <li>2–3 contexts</li>
            <li>Manual status</li>
            <li>Basic export</li>
          </ul>
          <a href="#waitlist" class="button-secondary clb-plan-btn">Get early access</a>
        </div>

        <div class="clb-plan glass-card clb-plan-featured">
          <div class="clb-plan-badge badge badge-gradient">Target tier</div>
          <div class="clb-plan-name">Pro</div>
          <div class="clb-plan-price">$9<span>/mo</span></div>
          <ul class="clb-plan-features">
            <li>Unlimited entries</li>
            <li>30-min ping schedule</li>
            <li>Voice transcription</li>
            <li>Google Sheets sync</li>
            <li>1-click status buttons</li>
            <li>Daily summaries</li>
          </ul>
          <a href="#waitlist" class="button clb-plan-btn">Join waitlist</a>
        </div>

        <div class="clb-plan glass-card">
          <div class="clb-plan-badge-coming">Planned</div>
          <div class="clb-plan-name">Power</div>
          <div class="clb-plan-price">$19<span>/mo</span></div>
          <ul class="clb-plan-features">
            <li>Everything in Pro</li>
            <li>Weekly reports</li>
            <li>Google Docs export</li>
            <li>Client reports</li>
            <li>Extended context history</li>
          </ul>
          <a href="#waitlist" class="button-secondary clb-plan-btn">Join waitlist</a>
        </div>
      </div>
    </section>

    <!-- ── VALIDATION QUESTIONS ── -->
    <section class="clb-section clb-validation">
      <div class="clb-section-label">Help shape the product</div>
      <h2 class="clb-section-title">Does this resonate with you?</h2>
      <div class="clb-validation-grid">
        {[
          { q: "Do you lose context when switching between projects?", emoji: "🔄" },
          { q: "Would you answer a 20-sec voice prompt every 30 min?", emoji: "🎙️" },
          { q: "Do you struggle to recall what you did when asked?", emoji: "🤔" },
          { q: "Would $9/mo be worth instant status updates?", emoji: "💳" },
        ].map((item) => (
          <div class="clb-validation-card glass-card">
            <span class="clb-validation-emoji">{item.emoji}</span>
            <p>{item.q}</p>
          </div>
        ))}
      </div>
      <p class="clb-validation-cta">If you answered <strong>yes</strong> to most of these — you're exactly who we're building for.</p>
    </section>

    <!-- ── WAITLIST ── -->
    <section id="waitlist" class="clb-section clb-waitlist">
      <div class="clb-waitlist-card glass-card animate-fade-in">
        <div class="clb-section-label">Early access</div>
        <h2 class="clb-waitlist-title">Be first to try it</h2>
        <p class="clb-waitlist-sub">We're building Context Log Bot and want to talk to early users. Leave your email — we'll reach out before launch.</p>

        <form
          class="clb-waitlist-form"
          name="clb-waitlist"
          method="POST"
          action="https://formspree.io/f/mwvjlpjp"
        >
          <input type="hidden" name="_subject" value="New Context Log Bot waitlist signup" />
          <input type="hidden" name="_next" value="https://borysonline.com/context-log-bot/#waitlist" />
          <div class="clb-form-row">
            <input
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              class="clb-email-input"
            />
            <button type="submit" class="button clb-submit-btn">
              Join waitlist
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
          <p class="clb-form-note">No spam · No product yet · Just validation. Unsubscribe any time.</p>
        </form>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ── PAGE WRAPPER ── */
  .clb-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  /* ── SHARED SECTION STYLES ── */
  .clb-section {
    padding: var(--spacing-3xl) 0;
  }

  .clb-section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .clb-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-2xl);
    line-height: 1.25;
  }

  /* ── HERO ── */
  .clb-hero {
    position: relative;
    text-align: center;
    padding: clamp(3rem, 8vw, 6rem) 0 var(--spacing-3xl);
    overflow: hidden;
  }

  .clb-hero-badge {
    margin-bottom: var(--spacing-lg);
    font-size: 0.8rem;
    gap: 0.4rem;
  }

  .clb-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-lg);
  }

  .clb-brand-name {
    display: block;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
  }

  .clb-hero-sub {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--color-text);
    line-height: 1.7;
    max-width: 620px;
    margin: 0 auto var(--spacing-2xl);
  }

  .clb-hero-cta {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-md);
  }

  .clb-btn-primary {
    gap: 0.5rem;
    font-size: 1rem;
    padding: 1rem 2rem;
  }

  .clb-btn-secondary {
    font-size: 1rem;
    padding: 1rem 2rem;
  }

  .clb-hero-note {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0;
  }

  .clb-hero-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse, var(--color-accent-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  /* ── PROBLEM GRID ── */
  .clb-problem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-lg);
  }

  .clb-problem-card {
    padding: var(--spacing-xl);
  }

  .clb-problem-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: var(--spacing-sm) 0 var(--spacing-sm);
  }

  .clb-problem-card p {
    font-size: 0.92rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .clb-problem-icon {
    font-size: 2rem;
    line-height: 1;
  }

  /* ── HOW IT WORKS ── */
  .clb-how .clb-section-title {
    margin-bottom: var(--spacing-xl);
  }

  .clb-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .clb-step {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-lg);
    padding: var(--spacing-xl);
  }

  .clb-step-num {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--color-gradient);
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .clb-step-body h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-xs);
  }

  .clb-step-body p {
    font-size: 0.92rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* ── DEMO CHAT ── */
  .clb-demo {
    padding: var(--spacing-lg);
    max-width: 560px;
    margin: 0 auto;
  }

  .clb-demo-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-md);
  }

  .clb-demo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .clb-dot-green { background: #22c55e; }
  .clb-dot-yellow { background: #eab308; }

  .clb-demo-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .clb-demo-chat {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .clb-msg {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 85%;
  }

  .clb-msg-bot { align-self: flex-start; }
  .clb-msg-user { align-self: flex-end; text-align: right; }

  .clb-msg-sender {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .clb-msg-text {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .clb-msg-user .clb-msg-text {
    background: var(--color-accent);
    border-color: transparent;
    color: white;
  }

  .clb-msg-status .clb-msg-text {
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
    white-space: pre-line;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .clb-msg-buttons {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .clb-tg-btn {
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .clb-tg-btn:hover { border-color: var(--color-accent); }
  .clb-tg-btn-accent {
    background: var(--color-gradient);
    color: white;
    border-color: transparent;
  }

  /* ── FEATURES ── */
  .clb-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--spacing-lg);
  }

  .clb-feature {
    padding: var(--spacing-xl);
  }

  .clb-feature-emoji {
    font-size: 1.8rem;
    line-height: 1;
    margin-bottom: var(--spacing-md);
  }

  .clb-feature h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--spacing-sm);
  }

  .clb-feature p {
    font-size: 0.88rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* ── AUDIENCE ── */
  .clb-audience-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .clb-audience-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
  }

  .clb-audience-emoji {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .clb-audience-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.2rem;
  }

  .clb-audience-card p {
    font-size: 0.88rem;
    color: var(--color-text);
    margin: 0;
  }

  /* ── PRICING ── */
  .clb-pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--spacing-lg);
    align-items: start;
  }

  .clb-plan {
    padding: var(--spacing-xl);
    position: relative;
  }

  .clb-plan-featured {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
    transform: translateY(-6px);
  }

  .clb-plan-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .clb-plan-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .clb-plan-price {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: var(--spacing-lg);
    line-height: 1;
  }

  .clb-plan-price span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .clb-plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .clb-plan-features li {
    font-size: 0.88rem;
